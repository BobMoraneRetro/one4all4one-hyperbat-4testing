<?xml version="1.0" encoding="UTF-8"?>
<theme>
	<formatVersion>7</formatVersion>
	<customView name="hyperbat" displayName="${viewchoice.hyperbat}" inherits="gamecarousel">
		<image name="Arrière-plan" extra="true">
			<path>./Arrière-plan.png</path>
			<origin>0.5 0.5</origin>
			<pos>0.500000000000 0.500000000000</pos>
			<size>1.000000000000 1.000000000000</size>
			<zIndex>200</zIndex>
			<scaleOrigin>-0.3 -0.3</scaleOrigin>
			<rotationOrigin>0.5 0.5</rotationOrigin>
			<linearSmooth>true</linearSmooth>
		</image>
		<video name="PreviewVid" extra="true">
			<path>{game:video}</path>
			<pos>0.22 0.554</pos>
			<maxSize>0.42 1.02</maxSize>
			<origin>0.5 0.5</origin>
			<rotationOrigin>0.5 0.5</rotationOrigin>
			<delay>0.4</delay>
			<effect>none</effect>
			<zIndex>210</zIndex>
						<shader>
				<!-- <path>:/shaders/border.glsl</path> -->
				<!-- <cornerRadius>0</cornerRadius> -->
				<!-- <borderSize>0.01</borderSize> -->
				<!-- <borderColor>000000</borderColor> -->
				<!-- <innerShadowSize>0.05</innerShadowSize> -->
				<!-- <innerShadowColor>00000010</innerShadowColor> -->
				<!-- <outerShadowSize>0.02</outerShadowSize> -->
				<!-- <outerShadowColor>00000090</outerShadowColor> -->
				<path>./angledshader.glsl</path>
				<!-- <borderSize>5</borderSize> -->
				<tiltAngle>0.2</tiltAngle>
				<tiltAngleX>-5</tiltAngleX>
				<perspectiveDepth>0.7</perspectiveDepth>
				<!-- <borderColorStart>1 1 1 1</borderColorStart>  -->
				<!-- <borderColorEnd>0.9 0.9 0.9 1</borderColorEnd>   -->
				<textureSize>1920.0 1080.0</textureSize>  
			</shader>
		</video>
		<control name="PreviewVid,Videobezel">
			<storyboard event="open">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="550" duration="500" mode="Linear"/>
				<animation property="scaleOrigin" to="0 0" begin="250" duration="" mode="Linear"/>
				<animation property="scale" from="0" to="1" begin="550" duration="500" mode="EaseIn"/>
			</storyboard>
			<storyboard event="activateNext">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="550" duration="500" mode="Linear"/>
				<animation property="scaleOrigin" to="0 0" begin="250" duration="" mode="Linear"/>
				<animation property="scale" from="0" to="1" begin="550" duration="500" mode="EaseIn"/>
			</storyboard>
			<storyboard event="activatePrev">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="550" duration="500" mode="Linear"/>
				<animation property="scaleOrigin" to="0 0" begin="250" duration="" mode="Linear"/>
				<animation property="scale" from="0" to="1" begin="550" duration="500" mode="EaseIn"/>
			</storyboard>
		</control>
		<image name="Videobezel" extra="true">
			<path>./Video.png</path>
			<origin>0.5 0.5</origin>
			<pos>0.2198 0.558</pos>
			<size>0.328 0.77</size>
			<zIndex>220</zIndex>
			<scaleOrigin>-0.3 -0.3</scaleOrigin>
			<rotationOrigin>0.5 0.5</rotationOrigin>
			<linearSmooth>true</linearSmooth>
		</image>
		<image name="Artwork3" extra="true">
			<path>./Artwork3.png</path>
			<origin>0.5 0.5</origin>
			<pos>0.225520833333 0.091203703704</pos>
			<size>0.128125000000 0.134259259259</size>
			<zIndex>230</zIndex>
			<scaleOrigin>-0.3 -0.3</scaleOrigin>
			<rotationOrigin>0.5 0.5</rotationOrigin>
			<linearSmooth>true</linearSmooth>
			<storyboard event="open">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="750" duration="500" mode="Linear"/>
				<animation property="offsetX" from="-1" to="0" begin="500" duration="4000" mode="EaseOutQuint"/>
			</storyboard>
			<storyboard event="activateNext">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="750" duration="1000" mode="Linear"/>
				<animation property="offsetX" from="-1" to="0" begin="500" duration="4000" mode="EaseOutQuint"/>
			</storyboard>
			<storyboard event="activatePrev">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="750" duration="1000" mode="Linear"/>
				<animation property="offsetX" from="-1" to="0" begin="500" duration="4000" mode="EaseOutQuint"/>
			</storyboard>
		</image>
		<image name="Artwork2" extra="true">
			<path>./Artwork2.png</path>
			<origin>0.5 0.5</origin>
			<pos>0.666406250000 0.567592592593</pos>
			<size>0.667187500000 0.864814814815</size>
			<zIndex>240</zIndex>
			<scaleOrigin>-0.3 -0.3</scaleOrigin>
			<rotationOrigin>0.5 0.5</rotationOrigin>
			<linearSmooth>true</linearSmooth>
			<storyboard event="open" repeatAt="1">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="rotation" to="0" begin="2" autoreverse="false" mode="Linear"/>
				<animation property="pos" from="2 -1" to="0.666406250000 0.567592592593" duration="1500" mode="easyOut"/>
				<animation property="opacity" from="0" to="1" duration="500" mode="linear"/>
				<animation property="origin" to="0.53 0.505" begin="500" duration="2000" mode="bump"/>
				<animation property="origin" to="0.50 0.500" begin="2500" duration="2000" mode="bump"/>
				<animation property="origin" to="0.53 0.505" begin="4500" duration="2000" mode="bump"/>
				<animation property="origin" to="0.50 0.500" begin="6500" duration="2000" mode="bump"/>
				<animation property="origin" to="0.53 0.53" begin="8500" duration="2000" mode="bump"/>
				<animation property="rotation" to="1" begin="9700" duration="800" autoreverse="false" mode="easeIn" editable="true"/>
				<animation property="pos" to="-1.8 2" begin="10500" duration="1500" mode="easyOut" editable="true"/>
				<animation property="opacity" from="1" to="0" begin="10500" duration="1500" mode="linear"/>
			</storyboard>
			<storyboard event="activateNext" repeatAt="1">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="rotation" to="0" begin="2" autoreverse="false" mode="Linear"/>
				<animation property="pos" from="2 -1" to="0.666406250000 0.567592592593" duration="1500" mode="easyOut"/>
				<animation property="opacity" from="0" to="1" duration="500" mode="linear"/>
				<animation property="origin" to="0.53 0.505" begin="500" duration="2000" mode="bump"/>
				<animation property="origin" to="0.50 0.500" begin="2500" duration="2000" mode="bump"/>
				<animation property="origin" to="0.53 0.505" begin="4500" duration="2000" mode="bump"/>
				<animation property="origin" to="0.50 0.500" begin="6500" duration="2000" mode="bump"/>
				<animation property="origin" to="0.53 0.53" begin="8500" duration="2000" mode="bump"/>
				<animation property="rotation" to="1" begin="9700" duration="800" autoreverse="false" mode="easeIn" editable="true"/>
				<animation property="pos" to="-1.8 2" begin="10500" duration="1500" mode="easyOut" editable="true"/>
				<animation property="opacity" from="1" to="0" begin="10500" duration="1500" mode="linear"/>
			</storyboard>
			<storyboard event="activatePrev" repeatAt="1">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="rotation" to="0" begin="2" autoreverse="false" mode="Linear"/>
				<animation property="pos" from="2 -1" to="0.666406250000 0.567592592593" duration="1500" mode="easyOut"/>
				<animation property="opacity" from="0" to="1" duration="500" mode="linear"/>
				<animation property="origin" to="0.53 0.505" begin="500" duration="2000" mode="bump"/>
				<animation property="origin" to="0.50 0.500" begin="2500" duration="2000" mode="bump"/>
				<animation property="origin" to="0.53 0.505" begin="4500" duration="2000" mode="bump"/>
				<animation property="origin" to="0.50 0.500" begin="6500" duration="2000" mode="bump"/>
				<animation property="origin" to="0.53 0.53" begin="8500" duration="2000" mode="bump"/>
				<animation property="rotation" to="1" begin="9700" duration="800" autoreverse="false" mode="easeIn" editable="true"/>
				<animation property="pos" to="-1.8 2" begin="10500" duration="1500" mode="easyOut" editable="true"/>
				<animation property="opacity" from="1" to="0" begin="10500" duration="1500" mode="linear"/>
			</storyboard>
		</image>
		<image name="Artwork1" extra="true">
			<path>./Artwork1.png</path>
			<origin>0.5 0.5</origin>
			<pos>0.770833333333 0.185648148148</pos>
			<size>0.419791666667 0.341666666667</size>
			<zIndex>250</zIndex>
			<scaleOrigin>-0.3 -0.3</scaleOrigin>
			<rotationOrigin>0.5 0.5</rotationOrigin>
			<linearSmooth>true</linearSmooth>
			<storyboard event="open">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="1000" duration="250" mode="linear"/>
				<animation property="scale" from="0.1" to="1" begin="1000" duration="2000" mode="Linear"/>
				<animation property="rotation" from="0" to="1080" begin="1000" duration="2000" repeat="" mode="Linear"/>
			</storyboard>
			<storyboard event="activateNext">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="1000" duration="250" mode="linear"/>
				<animation property="scale" from="0.1" to="1" begin="1000" duration="2000" mode="Linear"/>
				<animation property="rotation" from="0" to="1080" begin="1000" duration="2000" mode="Linear"/>
			</storyboard>
			<storyboard event="activatePrev">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="1000" duration="250" mode="linear"/>
				<animation property="scale" from="0.1" to="1" begin="1000" duration="2000" mode="Linear"/>
				<animation property="rotation" from="0" to="1080" begin="1000" duration="2000" repeat="" mode="Linear"/>
			</storyboard>
		</image>
		<image name="md_cartridge" extra="true">
			<visible>false</visible>
			<zIndex>260</zIndex>
		</image>
		<image name="md_boxart" extra="true">
			<visible>false</visible>
			<zIndex>260</zIndex>
		</image>
		<control name="Arrière-plan, Artwork1, Artwork2, Artwork3, PreviewVid, Videobezel">
			<storyboard event="deactivateNext">
				<animation property="scale" to="3" begin="" autoreverse="false" duration="200" mode="easyIn"/>
				<animation property="opacity" to="0" begin="100" duration="150" mode="linear"/>
			</storyboard>
			<storyboard event="deactivatePrev">
				<animation property="scale" to="3" begin="" autoreverse="false" duration="200" mode="easyIn"/>
				<animation property="opacity" to="0" begin="100" duration="150" mode="linear"/>
			</storyboard>
		</control>
	</customView>
</theme>
