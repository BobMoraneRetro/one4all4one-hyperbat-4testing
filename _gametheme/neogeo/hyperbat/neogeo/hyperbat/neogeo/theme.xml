<?xml version='1.0' encoding='utf-8'?>
<theme>
	<formatVersion>7</formatVersion>
	<customView name="hyperbat" displayName="${viewchoice.hyperbat}" inherits="gamecarousel">
		<text name="gamethemeauthor" extra="true">
			<text>Theme by : Bob Morane</text>
		</text>
		<image name="background" extra="true">
			<path>./Background.png</path>
			<pos>0.5 0.5</pos>
			<size>1 1</size>
			<origin>0.5 0.5</origin>
			<zIndex>100</zIndex>
			<scaleOrigin>0 -0.3</scaleOrigin>
		</image>
		<image name="logocust" extra="true">
			<maxSize>0.5 0.15</maxSize>
			<scaleOrigin>0 -0.3</scaleOrigin>
			<pos>0.5 0.5</pos>
			<origin>0.5 0.5</origin>
			<zIndex>230</zIndex>
			<storyboard event="open">
				<animation property="scaleOrigin" to="0 0" mode="Linear" />
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear" />
				<animation property="opacity" from="0" to="1" begin="600" duration="500" mode="linear" />
				<animation property="pos" to="0.5 0.5" begin="" duration="500" mode="EasyOut" />
				<animation property="scale" from="0" to="2.5" begin="600" duration="500" mode="EasyIn" />
				<animation property="pos" from="0.5 0.5" to="0.3 0.12" begin="1250" duration="500" mode="EasyOut" />
				<animation property="scale" from="2.5" to="1" begin="1250" duration="500" mode="Linear" />
			</storyboard>
			<storyboard event="activateNext">
				<animation property="scaleOrigin" to="0 0" mode="Linear" />
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear" />
				<animation property="opacity" from="0" to="1" begin="600" duration="500" mode="linear" />
				<animation property="pos" to="0.5 0.5" begin="" duration="500" mode="EasyOut" />
				<animation property="scale" from="0" to="2.5" begin="600" duration="500" mode="EasyIn" />
				<animation property="pos" from="0.5 0.5" to="0.3 0.12" begin="1250" duration="500" mode="EasyOut" />
				<animation property="scale" from="2.5" to="1" begin="1250" duration="500" mode="Linear" />
			</storyboard>
			<storyboard event="activatePrev">
				<animation property="scaleOrigin" to="0 0" mode="Linear" />
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear" />
				<animation property="opacity" from="0" to="1" begin="600" duration="500" mode="linear" />
				<animation property="pos" to="0.5 0.5" begin="" duration="500" mode="EasyOut" />
				<animation property="scale" from="0" to="2.5" begin="600" duration="500" mode="EasyIn" />
				<animation property="pos" from="0.5 0.5" to="0.3 0.12" begin="1250" duration="500" mode="EasyOut" />
				<animation property="scale" from="2.5" to="1" begin="1250" duration="500" mode="Linear" />
			</storyboard>
		</image>
		<image name="logocust" extra="true">
			<path>${intlogoclearsvg}</path>
			<path>${extlogoclearsvg}</path>
			<path>${intlogoclearpng}</path>
			<zIndex>230</zIndex>
		</image>
		<image name="logocust" extra="true" region="fr">
			<path>${intlogoclearfrsvg}</path>
			<path>${extlogoclearfrsvg}</path>
			<path>${intlogoclearfrpng}</path>
			<zIndex>230</zIndex>
		</image>
		<image name="logocust" extra="true" region="eu">
			<path>${intlogoclearfrsvg}</path>
			<path>${extlogoclearfrsvg}</path>
			<path>${intlogoclearfrpng}</path>
			<zIndex>230</zIndex>
		</image>
		<image name="logocust" extra="true" region="us">
			<path>${intlogoclearussvg}</path>
			<path>${extlogoclearussvg}</path>
			<path>${intlogoclearuspng}</path>
			<zIndex>230</zIndex>
		</image>
		<image name="logocust" extra="true" region="jp">
			<path>${intlogoclearjpsvg}</path>
			<path>${extlogoclearjpsvg}</path>
			<path>${intlogoclearjppng}</path>
			<zIndex>230</zIndex>
		</image>
		<image name="Artwork1" extra="true">
			<path>./Artwork1.png</path>
			<origin>0.5 0.5</origin>
			<zIndex>220</zIndex>
			<pos>0.7 0.52</pos>
			<maxSize>1 1</maxSize>
			<storyboard event="open">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear" />
				<animation property="opacity" from="0" to="1" begin="500" duration="1000" mode="Linear" />
				<animation property="offsetY" from="1" to="0" begin="500" duration="4000" mode="EaseOut" />
			</storyboard>
			<storyboard event="activateNext">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear" />
				<animation property="opacity" from="0" to="1" begin="500" duration="1000" mode="Linear" />
				<animation property="offsetY" from="1" to="0" begin="500" duration="4000" mode="EaseOut" />
			</storyboard>
			<storyboard event="activatePrev">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear" />
				<animation property="opacity" from="0" to="1" begin="500" duration="1000" mode="Linear" />
				<animation property="offsetY" from="1" to="0" begin="500" duration="4000" mode="EaseOut" />
			</storyboard>
		</image>
		<image name="Artwork2" extra="true">
			<path>./Artwork2.png</path>
			<scaleOrigin>-0.3 -0.3</scaleOrigin>
			<origin>0.5 0.5</origin>
			<zIndex>200</zIndex>
			<pos>0.8 0.6</pos>
			<size>0.6 0.8</size>
			<linearSmooth>true</linearSmooth>
			<storyboard event="open">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear" />
				<animation property="opacity" from="0" to="1" begin="200" duration="400" mode="Linear" />
				<animation property="offsetX" from="-1" to="0.05" begin="200" duration="400" mode="Linear" />
				<animation property="offsetX" from="0.05" to="-0.02" begin="600" duration="300" mode="EaseIn" />
				<animation property="offsetX" from="-0.02" to="0.005" begin="900" duration="200" mode="EaseIn" />
				<animation property="offsetX" from="0.005" to="0" begin="1100" duration="100" mode="EaseIn" />
			</storyboard>
			<storyboard event="activateNext">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear" />
				<animation property="opacity" from="0" to="1" begin="200" duration="400" mode="Linear" />
				<animation property="offsetX" from="-1" to="0.05" begin="200" duration="400" mode="Linear" />
				<animation property="offsetX" from="0.05" to="-0.02" begin="600" duration="300" mode="EaseIn" />
				<animation property="offsetX" from="-0.02" to="0.005" begin="900" duration="200" mode="EaseIn" />
				<animation property="offsetX" from="0.005" to="0" begin="1100" duration="100" mode="EaseIn" />
			</storyboard>
			<storyboard event="activatePrev">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear" />
				<animation property="opacity" from="0" to="1" begin="200" duration="400" mode="Linear" />
				<animation property="offsetX" from="-1" to="0.05" begin="200" duration="400" mode="Linear" />
				<animation property="offsetX" from="0.05" to="-0.02" begin="600" duration="300" mode="EaseIn" />
				<animation property="offsetX" from="-0.02" to="0.005" begin="900" duration="200" mode="EaseIn" />
				<animation property="offsetX" from="0.005" to="0" begin="1100" duration="100" mode="EaseIn" />
			</storyboard>
		</image>
		<video name="PreviewVid" extra="true">
			<visible>true</visible>
			<path>firstfile(
			"${path_syst_theme}/hyperpie/" + ({game:system:theme}) + ".mp4",
			"${path_syst_theme}/subsystem/" + ({game:system:theme}) + ".mp4",
			"${path_syst_theme}/subsystem/" + ({game:system:theme}) + ".avi",
			"${path_syst_theme}/subsystem/" + ({game:system:theme}) + ".flv",
			"${path_syst_theme}/subsystem/" + ({game:system:theme}) + ".mkv")</path>
			<maxSize>0.51 0.7</maxSize>
			<minSize>0.5 0.7</minSize>
			<origin>0.5 0.5</origin>
			<delay>0.3</delay>
			<showSnapshotNoVideo>false</showSnapshotNoVideo>
			<showSnapshotDelay>false</showSnapshotDelay>
			<effect>none</effect>
			<pos>0.3 0.55</pos>
			<zIndex>210</zIndex>
			<shader>
				<path>:/shaders/border.glsl</path>
				<cornerRadius>0.1</cornerRadius>
				<borderSize>0.018</borderSize>
				<borderColor>000000</borderColor>
				<innerShadowSize>0.01</innerShadowSize>
				<innerShadowColor>00000030</innerShadowColor>
				<outerShadowSize>0.020</outerShadowSize>
				<outerShadowColor>00000050</outerShadowColor>
			</shader>
		</video>
		<image name="PreviewScreen" extra="true">
			<visible>!exists("${path_syst_theme}/hyperpie/" + ({game:system:theme}) + ".mp4") &amp;&amp;
			!exists("${path_syst_theme}/subsystem/" + ({game:system:theme}) + ".mp4") &amp;&amp;
			!exists("${path_syst_theme}/subsystem/" + ({game:system:theme}) + ".avi") &amp;&amp;
			!exists("${path_syst_theme}/subsystem/" + ({game:system:theme}) + ".flv") &amp;&amp;
			!exists("${path_syst_theme}/subsystem/" + ({game:system:theme}) + ".mkv")</visible>
			<path>firstfile(
			"${path_syst_theme}/subsystem/" + ({game:system:theme}) + ".jpg",
			"${path_syst_theme}/subsystem/" + ({game:system:theme}) + ".png")</path>
			<size>0.51 0.7</size>
			<minSize>0.5 0.7</minSize>
			<origin>0.5 0.5</origin>
			<showSnapshotNoVideo>false</showSnapshotNoVideo>
			<showSnapshotDelay>false</showSnapshotDelay>
			<effect>none</effect>
			<pos>0.3 0.55</pos>
			<zIndex>210</zIndex>
			<shader>
				<path>:/shaders/border.glsl</path>
				<cornerRadius>0.1</cornerRadius>
				<borderSize>0.018</borderSize>
				<borderColor>000000</borderColor>
				<innerShadowSize>0.01</innerShadowSize>
				<innerShadowColor>00000030</innerShadowColor>
				<outerShadowSize>0.020</outerShadowSize>
				<outerShadowColor>00000050</outerShadowColor>
			</shader>
		</image>
		<image name="md_cartridge" extra="true">
			<visible>false</visible>
			<zIndex>240</zIndex>
		</image>
		<image name="md_boxart" extra="true">
			<visible>false</visible>
			<zIndex>240</zIndex>
		</image>
		<control name="Artwork1, Artwork2, PreviewScreen, PreviewVid, logocust">
			<storyboard event="deactivateNext">
				<animation property="scale" to="3" begin="" autoreverse="false" duration="200" mode="easyIn" />
				<animation property="opacity" to="0" begin="100" duration="150" mode="linear" />
			</storyboard>
			<storyboard event="deactivatePrev">
				<animation property="scale" to="3" begin="" autoreverse="false" duration="200" mode="easyIn" />
				<animation property="opacity" to="0" begin="100" duration="150" mode="linear" />
			</storyboard>
		</control>
	</customView>
</theme>