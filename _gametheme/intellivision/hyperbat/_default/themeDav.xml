<?xml version="1.0" encoding="UTF-8"?>
<theme>
	<formatVersion>7</formatVersion>
	<customView name="hyperbat" displayName="${viewchoice.hyperbat}" inherits="gamecarousel">
		<image name="Background-intellivision" extra="true">
			<visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'intellivision'</visible>
			<path>./Background.png</path>
			<origin>0.5 0.5</origin>
			<pos>0.500000000000 0.500000000000</pos>
			<size>1.000000000000 1.000000000000</size>
			<zIndex>100</zIndex>
		</image>
		<image name="screenshot-intellivision" extra="true">
			<visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'intellivision'</visible>
			<path>{game:image}</path>
			<origin>0.5 0.5</origin>
			<pos>0.442447916667 0.558796296296</pos>
			<size>0.389062500000 0.510185185185</size>
			<zIndex>200</zIndex>
			<linearSmooth>true</linearSmooth>
			<autoFade>false</autoFade>
		</image>
		<image name="previewvid-intellivision" extra="true">
			<visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'intellivision'</visible>
			<path>./previewvid.png</path>
			<origin>0.5 0.5</origin>
			<pos>0.442708333333 0.560648148148</pos>
			<size>0.385416666667 0.515740740741</size>
			<zIndex>210</zIndex>
			<linearSmooth>true</linearSmooth>
		</image>
		<image name="video-intellivision" extra="true">
			<visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'intellivision'</visible>
			<path>./video.png</path>
			<origin>0.5 0.5</origin>
			<pos>0.442447916667 0.567129629630</pos>
			<size>0.422395833333 0.580555555556</size>
			<zIndex>220</zIndex>
			<linearSmooth>true</linearSmooth>
		</image>
		<image name="console-intellivision" extra="true">
			<visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'intellivision'</visible>
			<path>./console.png</path>
			<origin>0.5 0.5</origin>
			<pos>0.158593750000 0.813888888889</pos>
			<size>0.317187500000 0.401851851852</size>
			<zIndex>230</zIndex>
			<linearSmooth>true</linearSmooth>
		</image>
		<image name="Calque 2-intellivision" extra="true">
			<visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'intellivision'</visible>
			<path>./Calque 2.png</path>
			<origin>0.5 0.5</origin>
			<pos>0.411979166667 0.183796296296</pos>
			<size>0.602083333333 0.287962962963</size>
			<zIndex>240</zIndex>
			<linearSmooth>true</linearSmooth>
		</image>
		<image name="cartridge-intellivision" extra="true">
			<visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'intellivision'</visible>
			<path>{game:cartridge}</path>
			<origin>0.5 0.5</origin>
			<pos>0.922135416667 0.743055555556</pos>
			<size>0.133854166667 0.295370370370</size>
			<zIndex>250</zIndex>
			<linearSmooth>true</linearSmooth>
			<autoFade>false</autoFade>
		</image>
		<image name="boxart-intellivision" extra="true" ifSubset="boxorthumb:thumb">
			<visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'intellivision'</visible>
			<path>firstfile({game:thumbnail},{game:boxart})</path>
			<origin>0.5 0.5</origin>
			<pos>0.817968750000 0.553703703704</pos>
			<maxSize>0.227604166667 0.551851851852</maxSize>
			<zIndex>270</zIndex>
			<linearSmooth>true</linearSmooth>
			<autoFade>false</autoFade>
		</image>
		<image name="boxart-intellivision" extra="true" ifSubset="boxorthumb:boxart">
			<visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'intellivision'</visible>
			<path>firstfile({game:boxart},{game:thumbnail})</path>
			<origin>0.5 0.5</origin>
			<pos>0.814322916667 0.556481481481</pos>
			<maxSize>0.178645833333 0.601851851852</maxSize>
			<zIndex>280</zIndex>
			<linearSmooth>true</linearSmooth>
			<autoFade>false</autoFade>
		</image>
		<image name="boxback-intellivision" ifSubset="boxorthumb:boxback" extra="true">
			<visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'intellivision'</visible>
			<path>{game:boxback}</path>
			<origin>1 0.5</origin>
			<pos>0.841210937500 0.524691358025</pos>
			<maxSize>0.258854166667 0.787037037037</maxSize>
			<zIndex>290</zIndex>
			<linearSmooth>true</linearSmooth>
			<shader>
				<path>./Angled_border_gradient.glsl</path>
				<tiltAngle>0</tiltAngle>
				<tiltAngleX>20</tiltAngleX>
				<perspectiveDepth>0.8</perspectiveDepth>
				<borderSize>8</borderSize>
				<borderColorStart>000000</borderColorStart>
				<borderColorEnd>000000</borderColorEnd>
				<gradientMode>4</gradientMode>
				<gradientMix>0.95</gradientMix>
				<gradientTransition>0.5</gradientTransition>
			</shader>
			<autoFade>false</autoFade>
		</image>
		<image name="boxart-intellivision" ifSubset="boxorthumb:boxback" extra="true">
			<visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'intellivision'</visible>
			<path>{game:boxart}</path>
			<origin>0 0.5</origin>
			<pos>0.798854166666 0.524691358025</pos>
			<maxSize>0.258854166667 0.629629629630</maxSize>
			<zIndex>291</zIndex>
			<linearSmooth>true</linearSmooth>
			<autoFade>false</autoFade>
		</image>
		<control name="screenshot-intellivision, previewvid-intellivision, video-intellivision, console-intellivision, Calque 2-intellivision, boxart-intellivision, boxart-intellivision, Grille_Alt3-intellivision, boxback-intellivision, boxart-intellivision">
			<storyboard event="deactivateNext">
				<animation property="scale" to="3" begin="" autoreverse="false" duration="200" mode="easyIn"/>
				<animation property="opacity" to="0" begin="100" duration="150" mode="linear"/>
			</storyboard>
			<storyboard event="deactivatePrev">
				<animation property="scale" to="3" begin="" autoreverse="false" duration="200" mode="easyIn"/>
				<animation property="opacity" to="0" begin="100" duration="150" mode="linear"/>
			</storyboard>
		</control>
		<control name="cartridge-intellivision">
			<storyboard event="deactivateNext">
				<animation property="opacity" to="0" begin="100" duration="150" mode="linear"/>
			</storyboard>
			<storyboard event="deactivatePrev">
				<animation property="opacity" to="0" begin="100" duration="150" mode="linear"/>
			</storyboard>
		</control>
		<text name="defaultthemeauthor" extra="true">
			<text>Theme by : Dav</text>
		</text>
	</customView>
</theme>
