<?xml version="1.0" encoding="UTF-8"?>
<theme>
	<formatVersion>7</formatVersion>
	<customView name="hyperbat" displayName="${viewchoice.hyperbat}" inherits="gamecarousel">
		<image name="Background" extra="true">
			<path>./Background.png</path>
			<origin>0.5 0.5</origin>
			<pos>0.500000000000 0.500000000000</pos>
			<size>1.000000000000 1.000000000000</size>
			<zIndex>100</zIndex>
			<scaleOrigin>0 -0.3</scaleOrigin>
		</image>
		<video name="PreviewVid" extra="true">
			<path>{game:video}</path>
			<pos>0.733585858586 0.723344556678</pos>
			<maxSize>0.403198653199 0.537598204265</maxSize>
			<origin>0.5 0.5</origin>
			<rotationOrigin>0.5 0.5</rotationOrigin>
			<delay>0.4</delay>
			<effect>none</effect>
			<zIndex>200</zIndex>
			<shader>
				<path>:/shaders/border.glsl</path>
				<cornerRadius>0.01</cornerRadius>
				<borderSize>0.020</borderSize>
				<borderColor>000000ff</borderColor>
				<innerShadowSize>0.01</innerShadowSize>
				<innerShadowColor>00000030</innerShadowColor>
				<outerShadowSize>0.020</outerShadowSize>
				<outerShadowColor>00000050</outerShadowColor>
			</shader>
		</video>
		<control name="PreviewVid,Videobezel">
			<storyboard event="open">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="1200" duration="500" mode="Linear"/>
				<animation property="offsetY" from="1" to="0" begin="1200" duration="500" mode="Linear"/>
				<animation property="rotation" from="0" to="360" begin="1200" duration="500" mode="Linear"/>
			</storyboard>
			<storyboard event="activateNext">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="1200" duration="500" mode="Linear"/>
				<animation property="offsetY" from="1" to="0" begin="1200" duration="500" mode="Linear"/>
				<animation property="rotation" from="0" to="360" begin="1200" duration="500" mode="Linear"/>
			</storyboard>
			<storyboard event="activatePrev">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="1200" duration="500" mode="Linear"/>
				<animation property="offsetY" from="1" to="0" begin="1200" duration="500" mode="Linear"/>
				<animation property="rotation" from="0" to="360" begin="1200" duration="500" mode="Linear"/>
			</storyboard>
		</control>
		<image name="Artwork1" extra="true">
			<path>./Artwork1.png</path>
			<origin>0.5 0.5</origin>
			<pos>0.247916666667 0.646759259259</pos>
			<size>0.522916666667 1.293518518519</size>
			<zIndex>210</zIndex>
			<scaleOrigin>-0.3 -0.3</scaleOrigin>
			<rotationOrigin>0.5 0.5</rotationOrigin>
			<linearSmooth>true</linearSmooth>
			<storyboard event="open">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="500" duration="350" mode="linear"/>
				<animation property="opacity" from="1" to="0.8" begin="1000" duration="100" autoreverse="true" repeat="5" mode="linear"/>
				<animation property="opacity" from="1" to="0.8" begin="1400" duration="50" autoreverse="true" repeat="3" mode="linear"/>
				<animation property="opacity" from="1" to="0.8" begin="1600" duration="70" autoreverse="true" repeat="2" mode="linear"/>
				<animation property="opacity" from="1" to="0.8" begin="2100" duration="50" autoreverse="true" repeat="4" mode="linear"/>
			</storyboard>
			<storyboard event="activateNext">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="500" duration="350" mode="linear"/>
				<animation property="opacity" from="1" to="0.8" begin="1000" duration="100" autoreverse="true" repeat="5" mode="linear"/>
				<animation property="opacity" from="1" to="0.8" begin="1400" duration="50" autoreverse="true" repeat="3" mode="linear"/>
				<animation property="opacity" from="1" to="0.8" begin="1600" duration="70" autoreverse="true" repeat="2" mode="linear"/>
				<animation property="opacity" from="1" to="0.8" begin="2100" duration="50" autoreverse="true" repeat="4" mode="linear"/>
			</storyboard>
			<storyboard event="activatePrev">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="500" duration="350" mode="linear"/>
				<animation property="opacity" from="1" to="0.8" begin="1000" duration="100" autoreverse="true" repeat="5" mode="linear"/>
