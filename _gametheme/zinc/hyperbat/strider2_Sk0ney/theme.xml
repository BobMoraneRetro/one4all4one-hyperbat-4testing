<?xml version="1.0" encoding="UTF-8"?>
<theme>
	<formatVersion>7</formatVersion>
	<customView name="hyperbat" displayName="${viewchoice.hyperbat}" inherits="gamecarousel">
		<image name="Background" extra="true">
			<path>./Background.png</path>
			<origin>0.5 0.5</origin>
			<pos>0.500000000000 0.500000000000</pos>
			<size>1.000000000000 1.000000000000</size>
			<zIndex>100</zIndex>
			<scaleOrigin>0 -0.3</scaleOrigin>
		</image>
		<image name="Artwork1" extra="true">
			<path>./Artwork1.png</path>
			<origin>0.5 0.5</origin>
			<pos>0.078380155724 0.070833333333</pos>
			<size>0.096354166667 0.039814814815</size>
			<zIndex>200</zIndex>
			<scaleOrigin>-0.3 -0.3</scaleOrigin>
			<rotationOrigin>0.5 0.5</rotationOrigin>
			<linearSmooth>true</linearSmooth>
			<storyboard event="open">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="1000" duration="500" mode="Linear"/>
				<animation property="offsetX" from="-1" to="0" begin="750" duration="4000" mode="EaseOutQuint"/>
			</storyboard>
			<storyboard event="activateNext">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="1000" duration="1000" mode="Linear"/>
				<animation property="offsetX" from="-1" to="0" begin="750" duration="4000" mode="EaseOutQuint"/>
			</storyboard>
			<storyboard event="activatePrev">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="1000" duration="1000" mode="Linear"/>
				<animation property="offsetX" from="-1" to="0" begin="750" duration="4000" mode="EaseOutQuint"/>
			</storyboard>
		</image>
		<video name="PreviewVid" extra="true">
			<path>{game:video}</path>
			<pos>0.628787878788 0.660680882903</pos>
			<maxSize>0.333333333333 0.444444444444</maxSize>
			<origin>0.5 0.5</origin>
			<rotationOrigin>0.5 0.5</rotationOrigin>
			<delay>0</delay>
			<effect>none</effect>
			<zIndex>210</zIndex>
			<rotation>10</rotation>
		</video>
		<image name="Videobezel" extra="true">
			<path>./Video.png</path>
			<origin>0.5 0.5</origin>
			<pos>0.634603851010 0.661728395062</pos>
			<size>0.400520833333 0.533333333333</size>
			<zIndex>220</zIndex>
			<scaleOrigin>-0.3 -0.3</scaleOrigin>
			<rotationOrigin>0.5 0.5</rotationOrigin>
			<rotation>10</rotation>
			<linearSmooth>true</linearSmooth>
		</image>
		<image name="Artwork3" extra="true">
			<path>./Artwork3.png</path>
			<origin>0.5 0.5</origin>
			<pos>0.190885416667 0.586111111111</pos>
			<size>0.381770833333 0.827777777778</size>
			<zIndex>230</zIndex>
			<scaleOrigin>-0.3 -0.3</scaleOrigin>
			<rotationOrigin>0.5 0.5</rotationOrigin>
			<linearSmooth>true</linearSmooth>
			<storyboard event="open">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="500" duration="500" mode="Linear"/>
				<animation property="offsetX" from="-1" to="0" begin="500" duration="500" mode="Linear"/>
			</storyboard>
			<storyboard event="activateNext">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="500" duration="500" mode="Linear"/>
				<animation property="offsetX" from="-1" to="0" begin="500" duration="500" mode="Linear"/>
			</storyboard>
			<storyboard event="activatePrev">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="500" duration="500" mode="Linear"/>
				<animation property="offsetX" from="-1" to="0" begin="500" duration="500" mode="Linear"/>
			</storyboard>
		</image>
		<image name="Artwork2" extra="true">
			<path>./Artwork2.png</path>
			<origin>0.5 0.5</origin>
			<pos>0.566927083333 0.230555555556</pos>
			<size>0.584895833333 0.446296296296</size>
			<zIndex>240</zIndex>
			<scaleOrigin>-0.3 -0.3</scaleOrigin>
			<rotationOrigin>0.5 0.5</rotationOrigin>
			<linearSmooth>true</linearSmooth>
			<storyboard event="open">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="250" duration="250" mode="linear"/>
				<animation property="scale" from="0.1" to="1" begin="250" duration="2000" mode="Linear"/>
				<animation property="rotation" from="0" to="1080" begin="250" duration="2000" repeat="" mode="Linear"/>
			</storyboard>
			<storyboard event="activateNext">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="250" duration="250" mode="linear"/>
				<animation property="scale" from="0.1" to="1" begin="250" duration="2000" mode="Linear"/>
				<animation property="rotation" from="0" to="1080" begin="250" duration="2000" mode="Linear"/>
			</storyboard>
			<storyboard event="activatePrev">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="250" duration="250" mode="linear"/>
				<animation property="scale" from="0.1" to="1" begin="250" duration="2000" mode="Linear"/>
				<animation property="rotation" from="0" to="1080" begin="250" duration="2000" repeat="" mode="Linear"/>
			</storyboard>
		</image>
		<image name="md_cartridge" extra="true">
			<visible>false</visible>
			<zIndex>250</zIndex>
		</image>
		<image name="md_boxart" extra="true">
			<visible>false</visible>
			<zIndex>250</zIndex>
		</image>
		<control name="Artwork1, Artwork2, Artwork3, PreviewVid, Videobezel">
			<storyboard event="deactivateNext">
				<animation property="scale" to="3" begin="" autoreverse="false" duration="200" mode="easyIn"/>
				<animation property="opacity" to="0" begin="100" duration="150" mode="linear"/>
			</storyboard>
			<storyboard event="deactivatePrev">
				<animation property="scale" to="3" begin="" autoreverse="false" duration="200" mode="easyIn"/>
				<animation property="opacity" to="0" begin="100" duration="150" mode="linear"/>
			</storyboard>
		</control>
		<text name="gamethemeauthor" extra="true">
			<text>Theme by : sk0ney</text>
		</text>
	</customView>
</theme>
