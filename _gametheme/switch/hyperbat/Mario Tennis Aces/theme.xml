<?xml version="1.0" encoding="UTF-8"?>
<theme>
	<formatVersion>7</formatVersion>
	<customView name="hyperbat" displayName="${viewchoice.hyperbat}" inherits="gamecarousel">
		<image name="Background" extra="true">
			<path>./Background.png</path>
			<origin>0.5 0.5</origin>
			<pos>0.500000000000 0.500000000000</pos>
			<size>1.000000000000 1.000000000000</size>
			<zIndex>100</zIndex>
			<scaleOrigin>0 -0.3</scaleOrigin>
		</image>
		<video name="PreviewVid" extra="true">
			<path>{game:video}</path>
			<pos>0.344270833333 0.588888888889</pos>
			<size>0.452083333333 0.435185185185</size>
			<origin>0.5 0.5</origin>
			<rotationOrigin>0.5 0.5</rotationOrigin>
			<delay>0.4</delay>
			<effect>none</effect>
			<zIndex>200</zIndex>
		</video>
		<image name="Artwork3" extra="true">
			<path>./Artwork3.png</path>
			<origin>0.5 0.5</origin>
			<pos>0.520833333333 0.160185185185</pos>
			<size>0.441666666667 0.235185185185</size>
			<zIndex>210</zIndex>
			<scaleOrigin>-0.3 -0.3</scaleOrigin>
			<rotationOrigin>0.5 0.5</rotationOrigin>
			<linearSmooth>true</linearSmooth>
			<storyboard event="open">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="800" duration="500" mode="Linear"/>
				<animation property="scaleOrigin" to="0 0" begin="500" duration="" mode="Linear"/>
				<animation property="scale" from="0" to="1" begin="800" duration="500" mode="EaseIn"/>
			</storyboard>
			<storyboard event="activateNext">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="800" duration="500" mode="Linear"/>
				<animation property="scaleOrigin" to="0 0" begin="500" duration="" mode="Linear"/>
				<animation property="scale" from="0" to="1" begin="800" duration="500" mode="EaseIn"/>
			</storyboard>
			<storyboard event="activatePrev">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="800" duration="500" mode="Linear"/>
				<animation property="scaleOrigin" to="0 0" begin="500" duration="" mode="Linear"/>
				<animation property="scale" from="0" to="1" begin="800" duration="500" mode="EaseIn"/>
			</storyboard>
		</image>
		<image name="Videobezel" extra="true">
			<path>./Video.png</path>
			<origin>0.5 0.5</origin>
			<pos>0.344270833333 0.587500000000</pos>
			<size>0.500000000000 0.519444444444</size>
			<zIndex>220</zIndex>
			<scaleOrigin>-0.3 -0.3</scaleOrigin>
			<rotationOrigin>0.5 0.5</rotationOrigin>
			<linearSmooth>true</linearSmooth>
		</image>
		<image name="Artwork2" extra="true">
			<path>./Artwork2.png</path>
			<origin>0.5 0.5</origin>
			<pos>0.468750000000 0.743981481481</pos>
			<size>0.238541666667 0.345370370370</size>
			<zIndex>230</zIndex>
			<scaleOrigin>-0.3 -0.3</scaleOrigin>
			<rotationOrigin>0.5 0.5</rotationOrigin>
			<linearSmooth>true</linearSmooth>
		</image>
		<image name="Artwork1" extra="true">
			<path>./Artwork1.png</path>
			<origin>0.5 0.5</origin>
			<pos>0.100781250000 0.666666666667</pos>
			<size>0.238020833333 0.603703703704</size>
			<zIndex>240</zIndex>
			<scaleOrigin>-0.3 -0.3</scaleOrigin>
			<rotationOrigin>0.5 0.5</rotationOrigin>
			<linearSmooth>true</linearSmooth>
			<storyboard event="open">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="250" duration="500" mode="Linear"/>
				<animation property="offsetX" from="-1" to="0" begin="0" duration="4000" mode="EaseOutQuint"/>
			</storyboard>
			<storyboard event="activateNext">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="250" duration="1000" mode="Linear"/>
				<animation property="offsetX" from="-1" to="0" begin="0" duration="4000" mode="EaseOutQuint"/>
			</storyboard>
			<storyboard event="activatePrev">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="250" duration="1000" mode="Linear"/>
				<animation property="offsetX" from="-1" to="0" begin="0" duration="4000" mode="EaseOutQuint"/>
			</storyboard>
		</image>
		<image name="Artwork4" extra="true">
			<path>./Artwork4.png</path>
			<origin>0.5 0.5</origin>
			<pos>0.114583333333 0.198611111111</pos>
			<size>0.210416666667 0.371296296296</size>
			<zIndex>250</zIndex>
			<scaleOrigin>-0.3 -0.3</scaleOrigin>
			<rotationOrigin>0.5 0.5</rotationOrigin>
			<linearSmooth>true</linearSmooth>
			<storyboard event="open" repeatAt="1">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="1000" duration="300" mode="Linear"/>
				<animation property="offsetX" from="1" to="-0.3" begin="1000" duration="2000" mode="Linear"/>
				<animation property="offsetY" from="0.7" to="-0.35" begin="1000" duration="1000" mode="EaseInOut"/>
				<animation property="offsetY" from="-0.35" to="2" begin="2000" duration="1200" mode="EaseInOut"/>
				<animation property="scale" from="0.2" to="1" begin="1000" duration="1500" mode="Linear"/>
			</storyboard>
			<storyboard event="activateNext" repeatAt="1">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="1000" duration="300" mode="Linear"/>
				<animation property="offsetX" from="1" to="-0.3" begin="1000" duration="2000" mode="Linear"/>
				<animation property="offsetY" from="0.7" to="-0.35" begin="1000" duration="1000" mode="EaseInOut"/>
				<animation property="offsetY" from="-0.35" to="2" begin="2000" duration="1200" mode="EaseInOut"/>
				<animation property="scale" from="0.2" to="1" begin="1000" duration="1500" mode="Linear"/>
			</storyboard>
			<storyboard event="activatePrev" repeatAt="1">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="1000" duration="300" mode="Linear"/>
				<animation property="offsetX" from="1" to="-0.3" begin="1000" duration="2000" mode="Linear"/>
				<animation property="offsetY" from="0.7" to="-0.35" begin="1000" duration="1000" mode="EaseInOut"/>
				<animation property="offsetY" from="-0.35" to="2" begin="2000" duration="1200" mode="EaseInOut"/>
				<animation property="scale" from="0.2" to="1" begin="1000" duration="1500" mode="Linear"/>
			</storyboard>
		</image>
		<image name="md_cartridge" extra="true">
			<visible>false</visible>
			<zIndex>260</zIndex>
		</image>
		<image name="md_boxart" extra="true">
			<visible>false</visible>
			<zIndex>260</zIndex>
		</image>
		<control name="Artwork1, Artwork2, Artwork3, Artwork4, PreviewVid, Videobezel">
			<storyboard event="deactivateNext">
				<animation property="scale" to="3" begin="" autoreverse="false" duration="200" mode="easyIn"/>
				<animation property="opacity" to="0" begin="100" duration="150" mode="linear"/>
			</storyboard>
			<storyboard event="deactivatePrev">
				<animation property="scale" to="3" begin="" autoreverse="false" duration="200" mode="easyIn"/>
				<animation property="opacity" to="0" begin="100" duration="150" mode="linear"/>
			</storyboard>
		</control>
		<text name="gamethemeauthor" extra="true">
			<text>Theme by : Akeshi</text>
		</text>
	</customView>
</theme>
