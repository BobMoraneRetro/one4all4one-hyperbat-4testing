<?xml version="1.0" encoding="UTF-8"?>
<theme>
	<formatVersion>7</formatVersion>
	<customView name="hyperbat" displayName="${viewchoice.hyperbat}" inherits="gamecarousel">
		<image name="Backgrounddef-atari" extra="true">
			<visible>${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'atari'</visible>
			<path>./Background.png</path>
			<origin>0.5 0.5</origin>
			<pos>0.500000000000 0.500000000000</pos>
			<size>1.000000000000 1.000000000000</size>
			<zIndex>100</zIndex>
		</image>
		<image name="art1def-atari" extra="true">
			<visible>${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'atari'</visible>
			<path>./art1.png</path>
			<origin>0.5 0.5</origin>
			<pos>0.267095921173 0.498871360295</pos>
			<size>0.534191842347 0.997742720589</size>
			<zIndex>200</zIndex>
			<linearSmooth>true</linearSmooth>
		</image>
		<image name="Marqueedef-atari" extra="true">
			<visible>${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'atari'</visible>
			<path>{game:marquee}</path>
			<origin>0.5 0.5</origin>
			<pos>0.766974520486 0.115671382993</pos>
			<maxSize>0.265402512594 0.153343673943</maxSize>
			<zIndex>210</zIndex>
			<linearSmooth>true</linearSmooth>
			<storyboard event="open">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="1200" duration="500" mode="Linear"/>
			</storyboard>
			<storyboard event="activateNext">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="1200" duration="500" mode="Linear"/>
			</storyboard>
			<storyboard event="activatePrev">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="1200" duration="500" mode="Linear"/>
			</storyboard>
		</image>
		<video name="gameplayprevdef-atari" extra="true">
			<visible>${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'atari'</visible>
			<path>{game:video}</path>
			<origin>0.5 0.5</origin>
			<pos>0.266144591987 0.568481317545</pos>
			<maxSize>0.334808761775 0.446916102347</maxSize>
			<zIndex>220</zIndex>
			<effect>none</effect>
			<delay>0.5</delay>
			<storyboard event="open">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="1500" duration="800" mode="EaseIn"/>
			</storyboard>
			<storyboard event="activateNext">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="1500" duration="800" mode="EaseIn"/>
			</storyboard>
			<storyboard event="activatePrev">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="1500" duration="800" mode="EaseIn"/>
			</storyboard>
		</video>
		<image name="Thumbdef-atari" extra="true">
			<visible>!exists({game:boxart}) &amp;&amp; ${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'atari'</visible>
			<path>{game:thumbnail}</path>
			<origin>0.5 0.5</origin>
			<pos>0.671887413460 0.579404093446</pos>
			<maxSize>0.231528770855 0.628725703825</maxSize>
			<zIndex>230</zIndex>
			<linearSmooth>true</linearSmooth>
			<storyboard event="open">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="250" duration="500" mode="Linear"/>
				<animation property="offsetY" from="1" to="0" duration="2000" mode="EaseOutQuint"/>
			</storyboard>
			<storyboard event="activateNext">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="250" duration="1000" mode="Linear"/>
				<animation property="offsetY" from="1" to="0" duration="2000" mode="EaseOutQuint"/>
			</storyboard>
			<storyboard event="activatePrev">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="250" duration="1000" mode="Linear"/>
				<animation property="offsetY" from="1" to="0" duration="2000" mode="EaseOutQuint"/>
			</storyboard>
		</image>
		<control name="art1-atari, Marquee-atari, gameplayprev-atari, Thumb-atari">
			<storyboard event="deactivateNext">
				<animation property="scale" to="3" begin="" autoreverse="false" duration="200" mode="easyIn"/>
				<animation property="opacity" to="0" begin="100" duration="150" mode="linear"/>
			</storyboard>
			<storyboard event="deactivatePrev">
				<animation property="scale" to="3" begin="" autoreverse="false" duration="200" mode="easyIn"/>
				<animation property="opacity" to="0" begin="100" duration="150" mode="linear"/>
			</storyboard>
		</control>
	</customView>
</theme>
