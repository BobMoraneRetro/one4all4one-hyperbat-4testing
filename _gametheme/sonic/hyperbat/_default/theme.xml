			<pos>0.233593750000 0.532870370370</pos>
			<size>0.510937500000 0.717592592593</size>
			<zIndex>220</zIndex>
			<linearSmooth>true</linearSmooth>
		</image>
		<image name="logo-sonic" extra="true">
			<!-- <visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'sonic'</visible> -->
