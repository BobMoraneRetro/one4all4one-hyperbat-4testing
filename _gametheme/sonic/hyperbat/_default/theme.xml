			<zIndex>260</zIndex>
			<linearSmooth>true</linearSmooth>
		</image>
		<image name="Eggman_modern_3D_art_Egg_Mobile-sonic" extra="true">
			<!-- <visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'sonic'</visible> -->
			<path>./Eggman_modern_3D_art_Egg_Mobile.png</path>
