<?xml version="1.0" encoding="UTF-8"?>
<theme>
	<formatVersion>7</formatVersion>
	<customView name="hyperbat" displayName="${viewchoice.hyperbat}" inherits="gamecarousel">
		<image name="Background-sonic" extra="true">
			<!-- <visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'sonic'</visible> -->
			<path>./background.png</path>
			<origin>0.5 0.5</origin>
			<pos>0.500000000000 0.500000000000</pos>
			<size>1.000000000000 1.000000000000</size>
			<zIndex>100</zIndex>
		</image>
		<video name="gameplayprev-sonic" extra="true">
			<!-- <visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'sonic'</visible> -->
			<path>{game:video}</path>
			<origin>0.5 0.5</origin>
			<pos>0.231770833333 0.531481481481</pos>
			<maxSize>0.334375000000 0.446296296296</maxSize>
			<zIndex>210</zIndex>
			<effect>none</effect>
			<delay>0.5</delay>
		</video>
		<image name="video4_3-sonic" extra="true">
			<!-- <visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'sonic'</visible> -->
