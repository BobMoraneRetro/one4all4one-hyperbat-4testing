			<size>0.127083333333 0.362962962963</size>
			<zIndex>280</zIndex>
			<linearSmooth>true</linearSmooth>
		</image>
		<image name="CARTRIDGE-sonic" extra="true">
			<!-- <visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'sonic'</visible> -->
			<path>{game:cartridge}</path>
			<origin>0.5 0.5</origin>
			<pos>0.917187500000 0.692592592593</pos>
			<size>0.154166666667 0.251851851852</size>
			<scale ifSubset="boxorthumb:boxback">1.000000000000</scale>
			<zIndex>290</zIndex>
			<linearSmooth>true</linearSmooth>
			<autoFade>false</autoFade>
		</image>
		<image name="boxart-sonic" extra="true">
			<!-- <visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'sonic'</visible> -->
			<path ifSubset="boxorthumb:thumb">firstfile({game:thumbnail},{game:boxart})</path>
			<path ifSubset="boxorthumb:boxart">firstfile({game:boxart},{game:thumbnail})</path>
			<origin>0.5 0.5</origin>
			<pos>0.720572916667 0.558333333333</pos>
			<maxSize>0.254687500000 0.553703703704</maxSize>
			<zIndex>300</zIndex>
			<linearSmooth>true</linearSmooth>
			<autoFade>false</autoFade>
		</image>
		<control name="gameplayprev-sonic, video4_3-sonic, logo-sonic, tails-sonic, art_sonic-sonic, knuckle-sonic, Eggman_modern_3D_art_Egg_Mobile-sonic, shadow-sonic, boxart-sonic">
			<storyboard event="deactivateNext">
				<!-- <animation property="scale" to="3" begin="" autoreverse="false" duration="200" mode="easyIn"/> -->
				<animation property="opacity" to="0" begin="100" duration="150" mode="linear"/>
			</storyboard>
			<storyboard event="deactivatePrev">
				<!-- <animation property="scale" to="3" begin="" autoreverse="false" duration="200" mode="easyIn"/> -->
				<animation property="opacity" to="0" begin="100" duration="150" mode="linear"/>
			</storyboard>
		</control>
		<control name="CARTRIDGE-sonic">
			<storyboard event="deactivateNext">
				<animation property="opacity" to="0" begin="100" duration="150" mode="linear"/>
			</storyboard>
			<storyboard event="deactivatePrev">
				<animation property="opacity" to="0" begin="100" duration="150" mode="linear"/>
			</storyboard>
		</control>
		<text name="defaultthemeauthor" extra="true">
			<text>Theme by : Dav</text>
		</text>
	</customView>
</theme>
