<?xml version="1.0" encoding="UTF-8"?>
<theme>
	<formatVersion>7</formatVersion>
	<variables>
		<!-- Variables utilisees dans ce fichier (definitions reprises de theme.xml) -->
		<!-- <bobmediapath>${themePath}/../_bobmedia</bobmediapath> -->
		<extgamescreenjpg>("${bobmediapath}/_gamemedia/"  + ({game:system:theme}) + "/screenshots/" + stem({game:rom}) + ".jpg")</extgamescreenjpg>
		<globalgamecabs>"${bobmediapath}/_gamemedia/" + ({game:system:theme}) + "/cabs/" + stem({game:rom}) + ".png"</globalgamecabs>
		<intcoinopscollec>()
		firstfile(  "${bobmediapath}/_gamemedia/" + ({game:system:theme}) + "/cabs/" + stem({game:rom}) + ".png",
					"${bobmediapath}/_gamemedia/" + ({game:system:theme}) + "/cabs/_"  + ({game:system:theme}) + ".png",
					"${bobmediapath}/_gamemedia//_systemcoinops/"  + ({game:system:theme}) + ".png",
					"${themePath}/_gamemedia/_defaultgamemedia/cabs/noir2j.png")
		</intcoinopscollec>
		<intcoinopsnext>("${themePath}/_viewgame/coinops/coinopsnext/"  + ({game:system:theme}) + ".png")</intcoinopsnext>
	</variables>
	<customView name="hyperbat" displayName="${viewchoice.hyperbat}" inherits="gamecarousel">
