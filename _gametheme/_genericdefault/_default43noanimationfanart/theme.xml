<?xml version="1.0" encoding="UTF-8"?>
<theme>
	<formatVersion>7</formatVersion>
	<customView name="hyperbat" displayName="${viewchoice.hyperbat}" inherits="gamecarousel">
		<!-- ######## Conditions de visibilité du theme generic : uniquement si pas de theme de jeu ni de theme defaut specific au système ############ -->
		<control name="BackgrSyst,blur,blur1,blur2,fiberback,genericbezel,previewvid1,logocustshadow,logocust,boxart2Dnoanimation,cartridge">
			<visible>!exists("${bobmediapath}/_gametheme/" + {game:system:theme} + "/hyperbat/" + stem({game:rom}) + "/theme.xml") &amp;&amp;
			!exists("${bobmediapath}/_gametheme/" + {game:system:theme} + "/hyperbat/_default/theme.xml") &amp;&amp;
			!exists("${bobmediapath}/_gametheme/${system.theme}/hyperbat/_default/theme.xml")</visible>
			<!-- <visible>!exists("${bobmediapath}/_gametheme/${system.theme}/hyperbat/_default/theme.xml")</visible> -->
		</control>
		<image name="BackgrSyst" extra="true">		
			<path ifSubset="custombuilds:standardbuilds">firstfile({game:fanart},{game:screenshot},{game:image},{game:thumbnail},{game:boxart},"${themePath}/_systemmedia/_fanartsysteme/fresh/${system.theme}.jpg")</path>
			<path ifSubset="custombuilds:retrofreshbat">firstfile({game:image},{game:fanart},{game:screenshot},{game:thumbnail},{game:boxart},"${themePath}/_systemmedia/_fanartsysteme/fresh/${system.theme}.jpg")</path>
			<pos>0.5 0.5</pos>
			<origin>0.5 0.5</origin>
			<size>1 1</size>
			<zIndex>0</zIndex>
			<opacity>0.5</opacity>
			<linearSmooth>true</linearSmooth>
			<storyboard>
				<animation property="opacity" from="0" to="0" begin="0" duration="1" mode="linear"/>
				<animation property="opacity" from="0" to="0.5" begin="0" duration="300" mode="linear"/>
			</storyboard>
			<storyboard event="activateNext">
				<animation property="opacity" from="0" to="0" begin="0" duration="1" mode="linear"/>
				<animation property="opacity" from="0" to="0.5" begin="0" duration="300" mode="linear"/>
			</storyboard>
			<storyboard event="activatePrev">
				<animation property="opacity" from="0" to="0" begin="0" duration="1" mode="linear"/>
				<animation property="opacity" from="0" to="0.5" begin="0" duration="300" mode="linear"/>
			</storyboard>
		</image>
		<!-- <screenshader name="blur" extra="true"> -->
			<!-- <path>:/shaders/blur.glsl</path> -->
			<!-- <size>1 1</size> -->
			<!-- <pos>0 0</pos> -->
			<!-- <blur>15</blur> -->
			<!-- <zIndex>1</zIndex> -->
			<!-- <blurColor>000000</blurColor> -->
		<!-- </screenshader> -->
		<!-- <screenshader name="blur1" extra="true"> -->
			<!-- <path>:/shaders/blur.glsl</path> -->
			<!-- <size>1 1</size> -->
			<!-- <pos>0 0</pos> -->
			<!-- <blur>8</blur> -->
			<!-- <zIndex>1</zIndex> -->
			<!-- <blurColor>000000</blurColor> -->
		<!-- </screenshader> -->
		<screenshader name="blur2" extra="true">
			<path>:/shaders/blur.glsl</path>
			<size>1 1</size>
			<pos>0 0</pos>
			<blur>2</blur>
			<zIndex>1</zIndex>
			<blurColor>000000</blurColor>
		</screenshader>
		<image name="screenshotgames" extra="true">
			<visible>!{game:folder} &amp;&amp; 
			!exists("${bobmediapath}/_gametheme/" + {game:system:theme} + "/hyperbat/" + stem({game:rom}) + "/theme.xml") &amp;&amp;
			!exists("${bobmediapath}/_gametheme/" + {game:system:theme} + "/hyperbat/_default/theme.xml") &amp;&amp;
			!exists("${bobmediapath}/_gametheme/${system.theme}/hyperbat/_default/theme.xml")</visible>
			<path>{game:image}</path>
			<origin>0.5 0.5</origin>
			<pos>0.27 0.52</pos>
			<maxSize>0.38 0.49</maxSize>
			<maxSize if="{system.theme} == 'ps3' 
			|| {system.theme} == 'xbox360'
			|| {system.theme} == 'psp'
			|| {system.theme} == 'psvita'
			|| {system.theme} == 'switch'
			|| {system.theme} == 'ps4'
			|| {system.theme} == 'ps5'
			|| {system.theme} == 'wiiu'
			|| {system.theme} == 'wii'
			|| {system.theme} == 'windows'
			|| {system.theme} == 'virtualboy'">0.5 0.49</maxSize>
			<zIndex>500</zIndex>
			<scaleOrigin>0.15 0.15</scaleOrigin>
			<autoFade>false</autoFade>
			<storyboard event="open">
				<animation property="opacity" to="1" duration="" mode="linear"/>
				<animation enabled="exists({game:video})" property="opacity" to="0" begin="625" duration="350" mode="easeOut"/>
			</storyboard>
			<storyboard event="activateNext">
				<animation property="opacity" to="1" duration="" mode="linear"/>
				<animation enabled="exists({game:video})" property="opacity" to="0" begin="625" duration="350" mode="easeOut"/>
			</storyboard>
			<storyboard event="activatePrev">
				<animation property="opacity" to="1" begin="" duration="" mode="easeIn"/>
				<animation enabled="exists({game:video})" property="opacity" to="0" begin="625" duration="350" mode="easeOut"/>
			</storyboard>
			<storyboard event="deactivateNext">
				<animation property="scale" from="1" to="1" begin="" duration="250" mode="linear"/>
				<animation property="opacity" to="0" begin="60" duration="" mode="easeIn"/>
			</storyboard>
			<storyboard event="deactivatePrev">
				<animation property="scale" from="1" to="1" begin="" duration="250" mode="linear"/>
				<animation property="opacity" to="0" begin="60" duration="" mode="easeIn"/>
			</storyboard>
		</image>
		<image name="fiberback" extra="true">
			<path>${themePath}/_viewgame/hyperbat/fondsysteme/fiber.png</path>
			<origin>0.5 0.5</origin>
			<rotationOrigin>0.5 0.5</rotationOrigin>
			<pos>0.27 0.52</pos>
			<size>0.37 0.5</size>
			<size if="{system.theme} == 'ps3' 
			|| {system.theme} == 'xbox360'
			|| {system.theme} == 'psp'
			|| {system.theme} == 'psvita'
			|| {system.theme} == 'switch'
			|| {system.theme} == 'ps4'
			|| {system.theme} == 'ps5'
			|| {system.theme} == 'wiiu'
			|| {system.theme} == 'wii'
			|| {system.theme} == 'windows'">0.5 0.5</size>
			<zIndex>199</zIndex>
		</image>
		<image name="genericbezel" extra="true">
			<path>./video.png</path>
			<linearSmooth>true</linearSmooth>
			<origin>0.5 0.5</origin>
			<rotationOrigin>0.5 0.5</rotationOrigin>
			<pos>0.27 0.52</pos>
			<maxSize>0.53 0.55</maxSize>
			<size if="{system.theme} == 'ps3' 
			|| {system.theme} == 'xbox360'
			|| {system.theme} == 'psp'
			|| {system.theme} == 'psvita'
			|| {system.theme} == 'switch'
			|| {system.theme} == 'ps4'
			|| {system.theme} == 'ps5'
			|| {system.theme} == 'wiiu'
			|| {system.theme} == 'wii'
			|| {system.theme} == 'windows'
			|| {system.theme} == 'virtualboy'">0.535 0.55</size>
			<zIndex>700</zIndex>
		</image>
		<video name="previewvid1" extra="true">
			<path>firstfile({game:video},
			"${bobmediapath}/_systemmedia/videosyst/hyperpie/" + {game:stem} + ".mp4",
			"${bobmediapath}/_systemmedia//defaut/scotty.mp4")</path>
			<origin>0.5 0.5</origin>
			<pos>0.27 0.52</pos>
			<maxSize>0.38 0.49</maxSize>
			<maxSize if="{system.theme} == 'ps3' 
			|| {system.theme} == 'xbox360'
			|| {system.theme} == 'psp'
			|| {system.theme} == 'psvita'
			|| {system.theme} == 'switch'
			|| {system.theme} == 'ps4'
			|| {system.theme} == 'ps5'
			|| {system.theme} == 'wiiu'
			|| {system.theme} == 'wii'
			|| {system.theme} == 'windows'
			|| {system.theme} == 'virtualboy'">0.5 0.49</maxSize>
			<zIndex>201</zIndex>
			<effect>none</effect>
			<delay>0.3</delay>
		</video>
		
		<image name="logocustshadow" extra="true">
			<maxSize>0.5 0.25</maxSize>
			<scaleOrigin>0 -0.3</scaleOrigin>
			<pos>0.278 0.183</pos>
			<origin>0.5 0.5</origin>
			<zIndex>900</zIndex>
			<color>000000</color>
			<path>{game:marquee}</path>
			<linearSmooth>true</linearSmooth>
			<horizontalAlignment>center</horizontalAlignment>
		</image>
		<image name="logocust" extra="true">
			<maxSize>0.5 0.25</maxSize>
			<scaleOrigin>0 -0.3</scaleOrigin>
			<pos>0.28 0.18</pos>
			<origin>0.5 0.5</origin>
			<zIndex>901</zIndex>
			<path>{game:marquee}</path>
			<linearSmooth>true</linearSmooth>
			<horizontalAlignment>center</horizontalAlignment>
		</image>
		<image name="boxart2Dnoanimation" extra="true">
			<path ifSubset="boxorthumb:thumb">firstfile({game:thumbnail},{game:boxart})</path>
			<path ifSubset="boxorthumb:boxart">firstfile({game:boxart},{game:thumbnail})</path>
			<pos ifSubset="boxorthumb:thumb">0.7 0.5</pos>
			<pos ifSubset="boxorthumb:boxart">0.7 0.55</pos>
			<origin>0.5 0.5</origin>
			<maxSize>0.3 0.65</maxSize>
			<zIndex>351</zIndex>
			<linearSmooth>true</linearSmooth>
			<color>FFFFFFFF</color>
			<colorEnd>cccccc</colorEnd>
			<verticalAlignment>bottom</verticalAlignment>
			<storyboard>
				<animation property="opacity" from="0" to="0" begin="0" duration="1" mode="linear"/>
				<animation property="opacity" from="0" to="1" begin="0" duration="300" mode="linear"/>
			</storyboard>
			<storyboard event="activateNext">
				<animation property="opacity" from="0" to="0" begin="0" duration="1" mode="linear"/>
				<animation property="opacity" from="0" to="1" begin="0" duration="300" mode="linear"/>
			</storyboard>
			<storyboard event="activatePrev">
				<animation property="opacity" from="0" to="0" begin="0" duration="1" mode="linear"/>
				<animation property="opacity" from="0" to="1" begin="0" duration="300" mode="linear"/>
			</storyboard>
		</image>
		<image name="cartridge" extra="true">
			<path>{game:cartridge}</path>
			<linearSmooth>true</linearSmooth>
			<pos>0.85 0.55</pos>
			<pos if="{system.theme} == 'n64' 
		|| {system.theme} == 'snes'">0.85 0.6</pos>
			<origin>0.5 0.5</origin>
			<maxSize>0.4 0.4</maxSize>
			<maxSize if="{system.theme} == 'n64' 
		|| {system.theme} == 'snes'
		|| {system.theme} == 'mastersystem'
		|| {system.theme} == 'actionmax'
		|| {system.theme} == 'megadrive'
		|| {system.theme} == 'sega32x'">0.4 0.35</maxSize>
			<zIndex>349</zIndex>
			<storyboard event="open">
				<animation property="opacity" from="0" to="0" begin="0" duration="" mode="linear"/>
				<animation property="opacity" from="0" to="1" begin="2000" duration="500" mode="linear"/>
				<animation property="x" from="1.5" begin="2000" duration="500" mode="linear"/>
			</storyboard>
			<storyboard event="activateNext">
				<animation property="opacity" from="0" to="0" begin="0" duration="" mode="linear"/>
				<animation property="opacity" from="0" to="1" begin="2000" duration="500" mode="linear"/>
				<animation property="x" from="1.5" begin="2000" duration="500" mode="linear"/>
			</storyboard>
			<storyboard event="activatePrev">
				<animation property="opacity" from="0" to="0" begin="0" duration="" mode="linear"/>
				<animation property="opacity" from="0" to="1" begin="2000" duration="500" mode="linear"/>
				<animation property="x" from="1.5" begin="2000" duration="500" mode="linear"/>
			</storyboard>
			<storyboard event="deactivateNext">
				<animation property="opacity" to="0" duration="150" mode="linear"/>
				<animation property="scale" to="3" autoreverse="false" duration="300" mode="easyIn"/>
			</storyboard>
			<storyboard event="deactivatePrev">
				<animation property="opacity" to="0" duration="150" mode="linear"/>
				<animation property="scale" to="3" autoreverse="false" duration="300" mode="easyIn"/>
			</storyboard>
		</image>
		<control name="cartridge" extra="true" if="{system.theme} == 'dreamcast' 
		|| {system.theme} == 'ps2' 
		|| {system.theme} == '3do' 
		|| {system.theme} == 'gc' 
		|| {system.theme} == 'wii'  
		|| {system.theme} == 'ps3' 
		|| {system.theme} == 'amigacd32' 
		|| {system.theme} == 'cdi' 
		|| {system.theme} == 'neogeocd' 
		|| {system.theme} == 'pce-cd' 
		|| {system.theme} == 'pcfx' 
		|| {system.theme} == 'psx' 
		|| {system.theme} == 'saturn' 
		|| {system.theme} == 'segacd' 
		|| {system.theme} == 'xbox360'
		|| {system.theme} == 'xbox'">
			<storyboard event="open">
				<animation property="opacity" from="0" to="0" begin="0" duration="" mode="linear"/>
				<animation property="opacity" from="0" to="1" begin="1750" duration="500" mode="linear"/>
				<animation property="x" from="1.5" begin="1750" duration="500" mode="linear"/>
				<animation property="rotation" from="-360" begin="2500" duration="2000" mode="EaseIn"/>
				<animation property="rotation" from="-360" begin="4500" duration="1000" mode="linear" repeat="forever"/>
			</storyboard>
			<storyboard event="activateNext">
				<animation property="opacity" from="0" to="0" begin="0" duration="" mode="linear"/>
				<animation property="opacity" from="0" to="1" begin="1750" duration="500" mode="linear"/>
				<animation property="x" from="1.5" begin="1750" duration="500" mode="linear"/>
				<animation property="rotation" from="-360" begin="2500" duration="5000" mode="EaseIn"/>
				<animation property="rotation" from="-360" begin="7500" duration="2900" mode="linear" repeat="forever"/>
			</storyboard>
			<storyboard event="activatePrev">
				<animation property="opacity" from="0" to="0" begin="0" duration="" mode="linear"/>
				<animation property="opacity" from="0" to="1" begin="1750" duration="500" mode="linear"/>
				<animation property="x" from="1.5" begin="1750" duration="500" mode="linear"/>
				<animation property="rotation" from="-360" begin="2500" duration="5000" mode="EaseIn"/>
				<animation property="rotation" from="-360" begin="7500" duration="2900" mode="linear" repeat="forever"/>
			</storyboard>
			<storyboard event="deactivateNext">
				<animation property="opacity" to="0" duration="150" mode="linear"/>
				<animation property="scale" to="3" autoreverse="false" duration="300" mode="easyIn"/>
			</storyboard>
			<storyboard event="deactivatePrev">
				<animation property="opacity" to="0" duration="150" mode="linear"/>
				<animation property="scale" to="3" autoreverse="false" duration="300" mode="easyIn"/>
			</storyboard>
		</control>
	</customView>
</theme>
