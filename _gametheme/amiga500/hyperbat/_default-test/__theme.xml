			<visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'amiga500'</visible>
			<path>{game:video}</path>
			<origin>0.5 0.5</origin>
			<pos>0.426302083333 0.389814814815</pos>
			<maxSize>0.242187500000 0.324074074074</maxSize>
			<zIndex>240</zIndex>
			<effect>none</effect>
			<delay>0.5</delay>
			<storyboard event="open">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
