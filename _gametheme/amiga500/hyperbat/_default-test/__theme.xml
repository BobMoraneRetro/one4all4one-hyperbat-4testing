			<!-- <path>./01.jpg</path> -->
			<origin>0.5 0.5</origin>
			<pos>0.500000000000 0.500000000000</pos>
			<size>1.000000000000 1.000000000000</size>
			<zIndex>100</zIndex>
		</image>
		<image name="Artwork1-amiga500" extra="true">
			<visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'amiga500'</visible>
			<path>./Artwork1.png</path>
			<origin>0.5 0.5</origin>
