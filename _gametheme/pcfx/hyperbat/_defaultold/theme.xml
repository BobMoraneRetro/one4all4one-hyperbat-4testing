<?xml version="1.0" encoding="UTF-8"?>
<theme>
	<formatVersion>7</formatVersion>
	<customView name="hyperbat" displayName="${viewchoice.hyperbat}" inherits="gamecarousel">
		<image name="Background-pcfx" extra="true">
			<visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'pcfx'</visible>
			<path>./Background.png</path>
			<origin>0.5 0.5</origin>
			<pos>0.499432527522 0.501008839960</pos>
			<size>1.000000000000 1.000000000000</size>
			<zIndex>100</zIndex>
		</image>
		<image name="screenshot-pcfx" extra="true">
			<visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'pcfx'</visible>
			<path>./screenshot.png</path>
			<origin>0.5 0.5</origin>
			<pos>0.384462603564 0.525731724234</pos>
			<size>0.328566564522 0.438088752695</size>
			<zIndex>210</zIndex>
			<linearSmooth>true</linearSmooth>
		</image>
		<video name="gameplayprev-pcfx" extra="true">
			<visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'pcfx'</visible>
			<path>{game:video}</path>
			<origin>0.5 0.5</origin>
			<pos>0.383989709832 0.525605619239</pos>
			<maxSize>0.325350887149 0.433801182865</maxSize>
			<zIndex>220</zIndex>
			<effect>none</effect>
			<delay>0.5</delay>
		</video>
		<image name="Video-pcfx" extra="true">
			<visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'pcfx'</visible>
			<path>./Video.png</path>
			<origin>0.5 0.5</origin>
			<pos>0.383895131086 0.525101199259</pos>
			<size>0.358075133356 0.481216660992</size>
			<zIndex>230</zIndex>
			<linearSmooth>true</linearSmooth>
		</image>
		<image name="Artwork3-pcfx" extra="true">
			<visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'pcfx'</visible>
			<path>./Artwork3.png</path>
			<origin>0.5 0.5</origin>
			<pos>0.310974917716 0.127783739035</pos>
			<size>0.600385881285 0.217231559585</size>
			<zIndex>240</zIndex>
			<linearSmooth>true</linearSmooth>
		</image>
		<image name="Artwork1-pcfx" extra="true">
			<visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'pcfx'</visible>
			<path>./Artwork1.png</path>
			<origin>0.5 0.5</origin>
			<pos>0.080037854667 0.504419980075</pos>
			<size>0.259950865389 0.518543739518</size>
			<zIndex>250</zIndex>
			<linearSmooth>true</linearSmooth>
		</image>
		<image name="Artwork4-pcfx" extra="true">
			<visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'pcfx'</visible>
			<path>./Artwork4.png</path>
			<origin>0.5 0.5</origin>
			<pos>0.130362828759 0.798138690274</pos>
			<size>0.234621923548 0.302944551634</size>
			<zIndex>260</zIndex>
			<linearSmooth>true</linearSmooth>
		</image>
		<image name="cartidge-pcfx" extra="true">
			<visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'pcfx'</visible>
			<path>{game:cartridge}</path>
			<origin>0.5 0.5</origin>
			<pos>0.880022131427 0.588935547737</pos>
			<maxSize>0.236948133016 0.421241125361</maxSize>
			<scale ifSubset="boxorthumb:boxback">1.000000000000</scale>
			<zIndex>270</zIndex>
			<linearSmooth>true</linearSmooth>
			<autoFade>false</autoFade>
			<storyboard event="open">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="1500" duration="500" mode="Linear"/>
				<animation property="offsetX" from="1" to="0" begin="1500" duration="1500" mode="Linear"/>
				<animation property="rotation" from="0" to="360" begin="3200" duration="1500" repeat="forever" mode="Linear"/>
			</storyboard>
			<storyboard event="activateNext">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="1500" duration="500" mode="Linear"/>
				<animation property="offsetX" from="1" to="0" begin="1500" duration="1500" mode="Linear"/>
				<animation property="rotation" from="0" to="360" begin="3200" duration="1500" repeat="forever" mode="Linear"/>
			</storyboard>
			<storyboard event="activatePrev">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="1500" duration="500" mode="Linear"/>
				<animation property="offsetX" from="1" to="0" begin="1500" duration="1500" mode="Linear"/>
				<animation property="rotation" from="0" to="360" begin="3200" duration="1500" repeat="forever" mode="Linear"/>
			</storyboard>
		</image>
		<image name="marquee-pcfx" extra="true">
			<visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'pcfx'</visible>
			<path>{game:marquee}</path>
			<origin>0.5 0.5</origin>
			<pos>0.834877050836 0.119043115298</pos>
			<maxSize>0.288545327586 0.151325994023</maxSize>
			<zIndex>280</zIndex>
			<linearSmooth>true</linearSmooth>
			<autoFade>false</autoFade>
			<storyboard event="open">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="650" duration="500" mode="Linear"/>
				<animation property="offsetY" from="-1" to="0" begin="650" duration="1500" mode="Linear"/>
			</storyboard>
			<storyboard event="activateNext">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="650" duration="500" mode="Linear"/>
				<animation property="offsetY" from="-1" to="0" begin="650" duration="1500" mode="Linear"/>
			</storyboard>
			<storyboard event="activatePrev">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="650" duration="500" mode="Linear"/>
				<animation property="offsetY" from="-1" to="0" begin="650" duration="1500" mode="Linear"/>
			</storyboard>
		</image>
		<image name="boxart-pcfx" extra="true" ifSubset="boxorthumb:thumb">
			<visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'pcfx'</visible>
			<path>firstfile({game:thumbnail},{game:boxart})</path>
			<origin>0.5 0.5</origin>
			<pos>0.730904551129 0.576679699073</pos>
			<maxSize>0.334808761775 0.582355980701</maxSize>
			<zIndex>300</zIndex>
			<linearSmooth>true</linearSmooth>
			<autoFade>false</autoFade>
			<storyboard event="open">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="650" duration="500" mode="Linear"/>
				<animation property="offsetY" from="1" to="0" begin="650" duration="1500" mode="Linear"/>
			</storyboard>
			<storyboard event="activateNext">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="650" duration="500" mode="Linear"/>
				<animation property="offsetY" from="1" to="0" begin="650" duration="1500" mode="Linear"/>
			</storyboard>
			<storyboard event="activatePrev">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="650" duration="500" mode="Linear"/>
				<animation property="offsetY" from="1" to="0" begin="650" duration="1500" mode="Linear"/>
			</storyboard>
		</image>
		<image name="boxart-pcfx" extra="true" ifSubset="boxorthumb:boxart">
			<visible ifSubset="HSperview:Yes">${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'pcfx'</visible>
			<path>firstfile({game:boxart},{game:thumbnail})</path>
			<origin>0.5 0.5</origin>
			<pos>0.736761796293 0.576552037226</pos>
			<maxSize>0.335173802550 0.509464179876</maxSize>
			<zIndex>290</zIndex>
			<linearSmooth>true</linearSmooth>
			<autoFade>false</autoFade>
		</image>
		<control name="screenshot-pcfx, gameplayprev-pcfx, Video-pcfx, Artwork3-pcfx, Artwork1-pcfx, Artwork4-pcfx, cartidge-pcfx, marquee-pcfx, boxart-pcfx, boxart-pcfx">
			<storyboard event="deactivateNext">
				<animation property="opacity" to="0" begin="100" duration="150" mode="linear"/>
			</storyboard>
			<storyboard event="deactivatePrev">
				<animation property="opacity" to="0" begin="100" duration="150" mode="linear"/>
			</storyboard>
		</control>
		<text name="defaultthemeauthor" extra="true">
			<text>Theme by : Roni</text>
		</text>
	</customView>
</theme>
