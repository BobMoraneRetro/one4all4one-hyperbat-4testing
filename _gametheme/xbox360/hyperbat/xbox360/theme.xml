			<zIndex>200</zIndex>
			<delay>0.4</delay>
			<effect>none</effect>
			<rotationOrigin>0.5 0.5</rotationOrigin>
			<shader>
				<path>${path_com_shaders}/border_multi_gradient.glsl</path>
				<cornerRadius>0.10</cornerRadius>
				<innerShadowSize>0</innerShadowSize>
				<innerShadowColor>00000030</innerShadowColor>
				<outerShadowSize>0</outerShadowSize>
				<outerShadowColor>00000050</outerShadowColor>
				<gradientMode>4</gradientMode>
				<saturation />
				<borderSize>0.015</borderSize>
				<borderColor>aeaeaeff</borderColor>
				<borderColorStart />
				<borderColorEnd />
				<borderSize2>0</borderSize2>
				<borderColor2>ffffff</borderColor2>
				<borderColorStart2>000000</borderColorStart2>
				<borderColorEnd2>ffffff</borderColorEnd2>
				<borderSize3>0.015</borderSize3>
				<borderColor3>00a400ff</borderColor3>
				<borderColorStart3 />
				<borderColorEnd3 />
			</shader>
			<storyboard event="open">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear" />
				<animation property="opacity" from="0" to="1" begin="650" duration="1000" mode="Linear" />
				<animation property="offsetX" from="-1" to="0" begin="650" duration="2500" mode="easeOut" />
			</storyboard>
			<storyboard event="activateNext">
