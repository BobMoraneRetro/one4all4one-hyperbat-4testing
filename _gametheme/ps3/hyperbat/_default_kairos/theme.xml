<?xml version="1.0" encoding="UTF-8"?>
<theme>
	<formatVersion>7</formatVersion>
	<customView name="hyperbat" displayName="${viewchoice.hyperbat}" inherits="gamecarousel">
		<image name="ps3-ps3" extra="true">
			<visible>${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'ps3'</visible>
			<path>./ps3.png</path>
			<origin>0.5 0.5</origin>
			<pos>0.500000000000 0.500000000000</pos>
			<size>1.008333333333 1.007407407407</size>
			<zIndex>200</zIndex>
			<linearSmooth>true</linearSmooth>
		</image>
		<image name="logo-ps3" extra="true">
			<visible>${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'ps3'</visible>
			<path>./logo.png</path>
			<origin>0.5 0.5</origin>
			<pos>0.280729166667 0.147222222222</pos>
			<size>0.405208333333 0.261111111111</size>
			<zIndex>210</zIndex>
			<linearSmooth>true</linearSmooth>
			<storyboard event="open">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="250" duration="500" mode="Linear"/>
				<animation property="offsetY" from="-1" to="0" duration="4000" mode="EaseOutQuint"/>
			</storyboard>
			<storyboard event="activateNext">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="250" duration="1000" mode="Linear"/>
				<animation property="offsetY" from="-1" to="0" duration="4000" mode="EaseOutQuint"/>
			</storyboard>
			<storyboard event="activatePrev">
				<animation property="opacity" from="0" to="0" begin="" duration="" mode="Linear"/>
				<animation property="opacity" from="0" to="1" begin="250" duration="1000" mode="Linear"/>
				<animation property="offsetY" from="-1" to="0" duration="4000" mode="EaseOutQuint"/>
			</storyboard>
		</image>
		<video name="gameplayprev-ps3" extra="true">
			<visible>${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'ps3'</visible>
			<path>{game:video}</path>
			<origin>0.5 0.5</origin>
			<pos>0.291145833333 0.566666666667</pos>
			<maxSize>0.426041666667 0.568518518519</maxSize>
			<zIndex>220</zIndex>
			<effect>none</effect>
			<delay>0.5</delay>
			<shader>
				<path>${bobmediapath}/_common/shaders/border_multi_gradient.glsl</path>
				<cornerRadius>0.00</cornerRadius>
				<innerShadowSize>0.01</innerShadowSize>
				<innerShadowColor>00000030</innerShadowColor>
				<outerShadowSize>0.020</outerShadowSize>
				<outerShadowColor>00000050</outerShadowColor>
				<gradientMode>4</gradientMode>
				<saturation/>
				<borderSize>0.035</borderSize>
				<borderColor>ffffffff</borderColor>
				<borderColorStart/>
				<borderColorEnd/>
				<borderSize2>0.020</borderSize2>
				<borderColor2>000000ff</borderColor2>
				<borderColorStart2/>
				<borderColorEnd2/>
				<borderSize3>0.015</borderSize3>
				<borderColor3>072185ff</borderColor3>
				<borderColorStart3/>
				<borderColorEnd3/>
			</shader>
		</video>
		<image name="Odin Sphere - Leifthrasir (USA)-ps3" extra="true">
			<visible>!exists({game:boxart}) &amp;&amp; ${IfnoextGamethemeexist} &amp;&amp; {game:system:theme} == 'ps3'</visible>
			<path>{game:thumbnail}</path>
			<origin>0.5 0.5</origin>
			<pos>0.665064709596 0.547259633371</pos>
			<maxSize>0.229119318182 0.633613916947</maxSize>
			<zIndex>230</zIndex>
			<linearSmooth>true</linearSmooth>
		</image>
		<control name="ps3-ps3, logo-ps3, gameplayprev-ps3, Odin Sphere - Leifthrasir (USA)-ps3">
			<storyboard event="deactivateNext">
				<animation property="scale" to="3" begin="" autoreverse="false" duration="200" mode="easyIn"/>
				<animation property="opacity" to="0" begin="100" duration="150" mode="linear"/>
			</storyboard>
			<storyboard event="deactivatePrev">
				<animation property="scale" to="3" begin="" autoreverse="false" duration="200" mode="easyIn"/>
				<animation property="opacity" to="0" begin="100" duration="150" mode="linear"/>
			</storyboard>
		</control>
		<text name="gamethemeauthor" extra="true">
			<text>Theme by : Kairos182</text>
		</text>
	</customView>
</theme>
