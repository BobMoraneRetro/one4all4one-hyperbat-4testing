<?xml version="1.0" encoding="UTF-8"?>
<theme>
	<formatVersion>7</formatVersion>
	<customView name="presetstarbox" displayName="${presetstarbox}" inherits="gamecarousel">
		<gamecarousel name="gamecarousel">
			<maxLogoCount ifSubset="spacebox:spacemmmmore">3</maxLogoCount>
			<maxLogoCount ifSubset="spacebox:spacemmmore">7</maxLogoCount>
			<maxLogoCount ifSubset="spacebox:spacemmore">11</maxLogoCount>
			<maxLogoCount ifSubset="spacebox:spacemore">15</maxLogoCount>
			<maxLogoCount ifSubset="spacebox:spacesmall">23</maxLogoCount>
			<maxLogoCount ifSubset="spacebox:spacessmall">33</maxLogoCount>
			<maxLogoCount ifSubset="spacebox:spacesssmall">43</maxLogoCount>
			<maxLogoCount ifSubset="spacebox:spacessssmall">53</maxLogoCount>
			<maxLogoCount ifSubset="spacebox:spacenorm">21</maxLogoCount>
			<scaledLogoSpacing ifSubset="spacebox:spacessssmall">10</scaledLogoSpacing>
			<scaledLogoSpacing ifSubset="spacebox:spacesssmall">8</scaledLogoSpacing>
			<scaledLogoSpacing ifSubset="spacebox:spacessmall">5</scaledLogoSpacing>
			<scaledLogoSpacing ifSubset="spacebox:spacesmall">2</scaledLogoSpacing>
			<scaledLogoSpacing ifSubset="spacebox:spacenorm">1.5</scaledLogoSpacing>
			<scrollSound ifSubset="gamewheelsound:bulle">${themePath}/_common/scrollsound/bulle.wav</scrollSound>
			<scrollSound ifSubset="gamewheelsound:clic">${themePath}/_common/scrollsound/clic.wav</scrollSound>
			<scrollSound ifSubset="gamewheelsound:clicgrave">${themePath}/_common/scrollsound/clicgrave.wav</scrollSound>
			<scrollSound ifSubset="gamewheelsound:frottement">${themePath}/_common/scrollsound/frottement.wav</scrollSound>
			<scrollSound ifSubset="gamewheelsound:poc">${themePath}/_common/scrollsound/poc.wav</scrollSound>
			<scrollSound ifSubset="gamewheelsound:wheelclic">${themePath}/_common/scrollsound/wheelclic.wav</scrollSound>
		</gamecarousel>
	</customView>
</theme>